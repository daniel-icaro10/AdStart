// Prisma schema — Catálogo de Ativos (BMs)
// SQLite para o MVP. Para migrar para Postgres: troque `provider` para "postgresql"
// e ajuste DATABASE_URL no .env (o restante do schema é compatível).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooler (pgbouncer) — usado pelo app
  directUrl = env("DIRECT_URL") // conexão direta — usada nas migrations
}

/// Uma BM (Business Manager) à venda/aluguel.
model Asset {
  id           String  @id @default(cuid())
  codigo       String // ex: "P100", "BM 01"
  titulo       String
  moeda        String // "BRL" | "USD"
  categoria    String // "DISPONIVEL" | "DOLAR" | "10K_50K" | "MAIS_50K" | "SEM_CATEGORIA"
  anoCriacao   Int?
  totalGastosBRL Float?
  totalGastosUSD Float?
  qtdContas    Int?
  verificada   Boolean @default(false)
  semDividas   Boolean @default(true)
  semBloqueios Boolean @default(true)
  statusVenda  String // "DISPONIVEL" | "RESERVADO" | "VENDIDO" | "PERDIDO"
  valor        Float   @default(0)
  destaque     Boolean @default(false) // tag "Nova"
  icone        String? // chave da bandeira/ícone (ex: "BR", "US")
  conteudo     String? // descrição em texto livre (estilo Notion)
  tier         Int? // tier da BM (1..3); null = nenhum

  // ─── Campos financeiros ─────────────────────────────────────────────────
  /// Tipo do ativo para fins financeiros: "BM" | "CONTA_ANUNCIO" | "KIT"
  tipo            String?
  fornecedor      String?
  custoAquisicao  Decimal?  @db.Decimal(12, 2)
  moedaCusto      String? // "BRL" | "USD"
  dataEntrada     DateTime? // backfillada com createdAt na migration
  precoPrevisto   Decimal?  @db.Decimal(12, 2)
  precoVenda      Decimal?  @db.Decimal(12, 2) // preço real (≠ `valor` público)
  moedaVenda      String? // moeda do preço de venda: "BRL" | "USD"
  taxaVendaNaDia  Decimal?  @db.Decimal(10, 4) // taxa USD→BRL congelada na venda
  comprador       String?
  dataSaida       DateTime?
  motivoPerda     String?
  observacoes     String?
  taxaCambioNaDia Decimal?  @db.Decimal(10, 4) // taxa USD→BRL do custo

  contas    AdAccount[] // contas de anúncio (CA 01, CA 02...)
  imagens   AssetImage[] // imagens exibidas no modal de detalhes (até 3)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([statusVenda, dataSaida])
  @@index([statusVenda, dataEntrada])
}

/// Imagem de uma BM (data URL base64). Exibida no modal de detalhes.
model AssetImage {
  id      String @id @default(cuid())
  assetId String
  asset   Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)
  data    String // data URL (base64)
  ordem   Int    @default(0)
}

/// Configurações simples chave/valor (ex.: ordem das categorias na landing).
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Conta de anúncio dentro de uma BM.
model AdAccount {
  id      String @id @default(cuid())
  assetId String
  asset   Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  nome       String // "CA 01"
  status     String // "ATIVA" | "NOVA" | etc
  gastos     Float?
  limiteMeta Float?
  cicloLivre Float?
  dividas    Float? @default(0)
}

/// Uma página/perfil à venda. `categoria` separa Páginas de Perfis (mesma estrutura).
model Page {
  id         String  @id @default(cuid())
  nome       String
  categoria  String  @default("PAGINA") // "PAGINA" | "PERFIL"
  nicho      String? // legado — info agora vai no texto livre `conteudo`
  kind       String // "COM" | "SEM" (com ou sem seguidores)
  seguidores Int     @default(0)
  anoCriacao Int?
  status     String // "DISPONIVEL" | "RESERVADO" | "VENDIDO" | "PERDIDO"
  valor      Float
  destaque   Boolean @default(false)
  conteudo   String? // descrição em texto livre (estilo Notion, igual à BM)
  quantidade Int     @default(1) // unidades em estoque (combos de página/perfil)

  imagens PageImage[] // imagens exibidas no modal de detalhes (até 3)
  vendas  Sale[] // vendas de unidades (cada unidade vendida = 1 registro)

  // ─── Campos financeiros ─────────────────────────────────────────────────
  /// Tipo do ativo para fins financeiros: "PERFIL" | "PAGINA"
  tipo            String?
  fornecedor      String?
  custoAquisicao  Decimal?  @db.Decimal(12, 2)
  moedaCusto      String? // "BRL" | "USD"
  dataEntrada     DateTime? // backfillada com createdAt na migration
  precoPrevisto   Decimal?  @db.Decimal(12, 2)
  precoVenda      Decimal?  @db.Decimal(12, 2)
  moedaVenda      String? // moeda do preço de venda: "BRL" | "USD"
  taxaVendaNaDia  Decimal?  @db.Decimal(10, 4) // taxa USD→BRL congelada na venda
  comprador       String?
  dataSaida       DateTime?
  motivoPerda     String?
  observacoes     String?
  taxaCambioNaDia Decimal?  @db.Decimal(10, 4)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, dataSaida])
  @@index([status, dataEntrada])
}

/// Imagem de uma Página (data URL base64). Exibida no modal de detalhes.
model PageImage {
  id     String @id @default(cuid())
  pageId String
  page   Page   @relation(fields: [pageId], references: [id], onDelete: Cascade)
  data   String // data URL (base64)
  ordem  Int    @default(0)
}

/// Venda de UMA unidade de uma página/perfil (combos). Cada unidade = 1 registro,
/// para o financeiro contar cada venda no período correto.
model Sale {
  id        String   @id @default(cuid())
  pageId    String
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  preco     Float // preço de venda da unidade (R$)
  custo     Float? // custo da unidade (R$), copiado do ativo na venda
  comprador String?
  data      DateTime // data da venda
  createdAt DateTime @default(now())

  @@index([data])
  @@index([pageId])
}

/// Despesa operacional que não é compra de ativo mas impacta o lucro real.
model CustoOperacional {
  id        String  @id @default(cuid())
  descricao String
  /// "INFRAESTRUTURA" | "TRAFEGO" | "FERRAMENTAS" | "OUTROS"
  categoria String
  valor     Decimal @db.Decimal(12, 2)
  moeda     String // "BRL" | "USD"
  data      DateTime
  recorrente      Boolean  @default(false)
  taxaCambioNaDia Decimal? @db.Decimal(10, 4) // taxa USD→BRL no dia do lançamento
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([data])
  @@index([categoria])
}

/// Usuário administrador (sem registro público — criado via seed).
model User {
  id       String  @id @default(cuid())
  email    String  @unique
  password String // hash bcrypt
  name     String?
  role     String  @default("ADMIN")
}

/// Plano de aluguel de contas de agência. Preços/quotas 100% editáveis no admin.
model RentalPlan {
  id                           String  @id @default(cuid())
  nome                         String // ex: "Plano A"
  slug                         String  @unique
  precoMensal                  Float // preço mensal em R$
  contasAtivas                 Int     @default(0) // contas de anúncio ativas
  reposicoesIlimitadas         Boolean @default(false)
  paginasAntigas2021           Boolean @default(false)
  paginasAntigas2021Ilimitadas Boolean @default(false)
  perfisVerificados            Int     @default(0)
  beneficios                   String? // benefícios extras em texto livre (um por linha)
  destaque                     Boolean @default(false) // "mais popular"
  ordem                        Int     @default(0) // ordenação dos cards
  ativo                        Boolean @default(true) // mostra/oculta na landing

  clientes Client[] // clientes vinculados a este plano

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ativo, ordem])
}

/// Cliente do controle de aluguéis (CRM simples — admin only).
model Client {
  id             String      @id @default(cuid())
  nome           String
  contato        String? // whatsapp/telefone/email
  planId         String?
  plan           RentalPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)
  valorMensal    Float? // R$/mês (sugestão do plano, editável)
  dataVencimento DateTime? // próximo vencimento
  status         String      @default("ATIVO") // "ATIVO" | "PAUSADO" | "CANCELADO"
  observacoes    String? // anotações livres sobre o cliente
  // Idempotência dos avisos (guardam o vencimento já avisado em cada etapa):
  avisoPreEm        DateTime? // aviso "3 dias antes" já enviado para esse vencimento
  avisoDiaEm        DateTime? // aviso "no dia/vencido" já enviado para esse vencimento
  // Vencimento marcado como PAGO pelo admin → não dispara aviso.
  pagoVencimentoEm  DateTime?

  entries ClientEntry[] // linhas da planilha do cliente

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, dataVencimento])
}

/// Linha da planilha editável de um cliente (pagamentos/histórico).
model ClientEntry {
  id        String    @id @default(cuid())
  clientId  String
  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  data      DateTime?
  descricao String    @default("")
  valor     Float?
  status    String    @default("") // ex: "pago" | "pendente" | "atrasado"
  ordem     Int       @default(0)

  createdAt DateTime @default(now())

  @@index([clientId, ordem])
}
