# ----------------------------------------------------------------------------
# Banco de dados — PostgreSQL (Supabase)
# No painel do Supabase: Project Settings → Database → Connection string → Prisma
#   DATABASE_URL = pooler (porta 6543, com ?pgbouncer=true) — usado pelo app
#   DIRECT_URL   = conexão direta (porta 5432) — usado nas migrations
# ----------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres.xxxx:[SENHA]@aws-0-REGIAO.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxx:[SENHA]@aws-0-REGIAO.pooler.supabase.com:5432/postgres"

# ----------------------------------------------------------------------------
# NextAuth / Auth.js
# Gere um segredo forte com:  openssl rand -base64 32
# ----------------------------------------------------------------------------
NEXTAUTH_SECRET="troque-por-um-segredo-aleatorio-forte"
NEXTAUTH_URL="http://localhost:3000"

# ----------------------------------------------------------------------------
# Admin inicial — usado APENAS pelo script de seed (prisma/seed.ts).
# A conta é criada manualmente pelo dono rodando `npm run db:seed`.
# Nunca há registro público.
# ----------------------------------------------------------------------------
ADMIN_EMAIL="admin@suaagencia.com"
ADMIN_PASSWORD="troque-esta-senha-forte"
ADMIN_NAME="Administrador"

# ----------------------------------------------------------------------------
# Links de contato exibidos na landing (públicos — prefixo NEXT_PUBLIC_)
# ----------------------------------------------------------------------------
# Número no formato internacional sem "+" nem espaços, ex: 5511999999999
NEXT_PUBLIC_WHATSAPP_NUMBER="5511999999999"
NEXT_PUBLIC_INSTAGRAM_URL="https://instagram.com/suaagencia"
NEXT_PUBLIC_COMMUNITY_URL="https://t.me/suacomunidade"

# Identidade da agência (exibida na landing)
NEXT_PUBLIC_AGENCY_NAME="Agência de Contingência"
